---
import '../styles/site.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { route, ROUTES, type Langue, type Page } from '../i18n/config';

interface Props {
  langue: Langue;
  page: Page | 'note';
  titre: string;
  description: string;
  type?: string;
  /* Pour une note de marche, dont l'adresse ne figure pas dans ROUTES. */
  alternatives?: Partial<Record<Langue, string>>;
}
const { langue, page, titre, description, type, alternatives } = Astro.props;

const liens: Partial<Record<Langue, string>> =
  alternatives ?? (page !== 'note' ? { ...ROUTES[page] } : { fr: route('accueil', 'fr') });
---
<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap"
    />
    <Seo langue={langue} titre={titre} description={description} type={type} alternatives={liens} />
  </head>
  <body>
    <Header langue={langue} page={page} alternatives={liens} />
    <main><slot /></main>
    <Footer langue={langue} />
  </body>
</html>
