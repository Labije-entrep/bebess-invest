---
import '../styles/app.css';
import '../styles/public.css';
import { attributsCabinet } from '../lib/personnalisation';
import { T, chemin, type Lg } from '../lib/publang';
import { envDe } from '../lib/mail';
import { urlLogoCabinet } from '../lib/fichiers';
import { origineDuSite, pageHorsAdresseDuSite } from '../lib/adresses';

interface Props {
  titre: string;
  description?: string;
  langue?: Lg;
}
const { titre, description = '', langue = 'fr' } = Astro.props;
const l = T[langue];
const nom = Astro.locals.tenant?.nom ?? "Labije Cab";
const logo = Astro.locals.tenant ? await urlLogoCabinet(envDe(Astro.locals).DB, Astro.locals.tenant.id) : null;
// La canonique pointe l'adresse du site public du cabinet, pas l'hôte de la requête ; hors de cette adresse, la page n'est pas indexée.
const canonique = origineDuSite(Astro.locals.tenant, Astro.url) + Astro.url.pathname;
const horsAdresse = pageHorsAdresseDuSite(Astro.locals.tenant, Astro.url);
const liens: [string, string][] = [
  [chemin('approche', langue), l.nav.approche],
  [chemin('parcours', langue), l.nav.parcours],
  [chemin('notes', langue), l.nav.notes],
  [chemin('contact', langue), l.nav.contact],
  ['/connexion', l.nav.espace],
];
const ici = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang={langue} data-cabinet-theme={Astro.locals.tenant?.theme ?? 'maison'} {...attributsCabinet(Astro.locals.tenant?.personnalisation, Astro.locals.tenant?.theme ?? 'maison')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonique} />
    {horsAdresse && <meta name="robots" content="noindex" />}
  </head>
  <body class="pub">
    <header class="pub-haut">
      <div class="wrap pub-barre">
        <a class="pub-marque" href={chemin('accueil', langue)}>{logo && <img class="logo-cabinet" src={logo} alt="" height="32" />}{nom}</a>
        <button class="btn pub-burger" type="button" aria-expanded="false" aria-controls="pub-menu" data-menu>{l.menu}</button>
        <nav id="pub-menu" class="pub-menu" aria-label={l.navAria}>
          {liens.map(([href, lib]) => <a href={href} aria-current={ici === href || ici.startsWith(`${href}/`) ? 'page' : undefined}>{lib}</a>)}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="pub-pied">
      <div class="wrap">
        <span>{nom}</span>
        <nav aria-label={l.pied}>
          <a href={chemin('contact', langue)}>{l.nav.contact}</a>
          <a href={chemin('mentions', langue)}>{l.mentions}</a>
        </nav>
      </div>
    </footer>
    <script is:inline nonce={Astro.locals.nonce}>
      var b = document.querySelector('[data-menu]'), m = document.getElementById('pub-menu');
      b.addEventListener('click', function () {
        var o = m.classList.toggle('ouvert');
        b.setAttribute('aria-expanded', o ? 'true' : 'false');
      });
    </script>
  </body>
</html>

<style is:global>
  .logo-cabinet { height: 2rem; width: auto; vertical-align: middle; margin-right: var(--espace-xs); }
</style>
