---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getCabinet } from '../data';
import { route, routeNote, t, type Langue } from '../i18n/config';

interface Props { langue: Langue; note: CollectionEntry<'notes'> }
const { langue, note } = Astro.props;
const cabinet = getCabinet(langue);
const l = t(langue);
const { Content } = await render(note);

const slug = note.id.slice(langue.length + 1);
const dateLongue = note.data.date.toLocaleDateString(langue === 'fr' ? 'fr-FR' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---
<Base
  langue={langue}
  page="note"
  titre={note.data.titre}
  description={note.data.description ?? note.data.chapeau}
  type="article"
  alternatives={{ [langue]: routeNote(slug, langue) }}
>
  <section style="border-top:0">
    <div class="wrap wrap--texte">
      <div class="intro-page">
        <span class="mono">{l.noteEyebrow} <time datetime={note.data.date.toISOString()}>{dateLongue}</time></span>
        <h1>{note.data.titre}</h1>
        <p class="chapeau">{note.data.chapeau}</p>
      </div>
      <article class="prose"><Content /></article>
      <div class="actions">
        <a class="btn btn--discret" href={route('notes', langue)}>{l.toutesLesNotes}</a>
        <a class="btn" href={route('contact', langue)}>{l.prendreRendezVous}</a>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: note.data.titre,
    description: note.data.description ?? note.data.chapeau,
    datePublished: note.data.date.toISOString(),
    inLanguage: langue,
    author: { '@type': 'Organization', name: cabinet.nom },
  })} />
</Base>
