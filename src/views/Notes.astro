---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getSeo } from '../data';
import { routeNote, t, type Langue } from '../i18n/config';

interface Props { langue: Langue }
const { langue } = Astro.props;
const seo = getSeo(langue);
const l = t(langue);

/* Les notes sont rangees par langue : src/content/notes/<langue>/ */
const notes = (
  await getCollection('notes', ({ id, data }) => id.startsWith(`${langue}/`) && data.publie !== false)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const slug = (id: string) => id.slice(langue.length + 1);
const dateCourte = (d: Date) =>
  d.toLocaleDateString(langue === 'fr' ? 'fr-FR' : 'en-GB', { month: 'short', year: 'numeric' });
---
<Base langue={langue} page="notes" titre={seo.notes.titre} description={seo.notes.description}>
  <section style="border-top:0">
    <div class="wrap">
      <div class="intro-page">
        <span class="mono">{l.notesEyebrow}</span>
        <h1>{l.notesTitre}</h1>
        <p class="chapeau">{l.notesChapeau}</p>
      </div>
      <div style="margin-top:34px">
        {notes.map((n) => (
          <a class="note" href={routeNote(slug(n.id), langue)}>
            <span class="date">{dateCourte(n.data.date)}</span>
            <div><h3>{n.data.titre}</h3><p>{n.data.chapeau}</p></div>
          </a>
        ))}
        {notes.length === 0 && <p class="chapeau">{l.notesVides}</p>}
      </div>
    </div>
  </section>
</Base>
