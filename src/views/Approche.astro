---
import Base from '../layouts/Base.astro';
import Valeur from '../components/Valeur.astro';
import { getCabinet, getSeo } from '../data';
import { t, type Langue } from '../i18n/config';

interface Props { langue: Langue }
const { langue } = Astro.props;
const cabinet = getCabinet(langue);
const seo = getSeo(langue);
const l = t(langue);
---
<Base langue={langue} page="approche" titre={seo.approche.titre} description={seo.approche.description}>
  <section style="border-top:0">
    <div class="wrap">
      <div class="intro-page">
        <span class="mono">{l.menu.approche}</span>
        <h1>{l.approcheTitre}</h1>
        <p class="chapeau">{l.approcheChapeau}</p>
      </div>
      <div class="etapes">
        {cabinet.methode.map((e, i) => (
          <div class="etape">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div><h3><Valeur v={e.titre} /></h3><p><Valeur v={e.texte} /></p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bande--marine">
    <div class="wrap">
      <div class="titre-section"><span class="mono">{l.transparence}</span><h2>{l.honorairesTitre}</h2></div>
      <p class="chapeau">{l.honorairesChapeau}</p>
      <div class="grille grille--3" style="margin-top:30px">
        {cabinet.honoraires.map((h) => (
          <div class="case">
            <span class="mono"><Valeur v={h.etiquette} /></span>
            <h3><Valeur v={h.montant} /></h3>
            <p><Valeur v={h.texte} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="titre-section"><span class="mono">{l.clienteleEyebrow}</span><h2>{l.clienteleTitre}</h2></div>
      <div class="grille grille--3" style="margin-top:28px">
        {cabinet.clienteles.map((c) => (
          <div class="case">
            <span class="mono"><Valeur v={c.etiquette} /></span>
            <h3><Valeur v={c.titre} /></h3>
            <p><Valeur v={c.texte} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
