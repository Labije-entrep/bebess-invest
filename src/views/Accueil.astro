---
import Base from '../layouts/Base.astro';
import Valeur from '../components/Valeur.astro';
import { getCabinet, getSeo, MARQUEUR, nettoyer } from '../data';
import { route, t, type Langue } from '../i18n/config';

interface Props { langue: Langue }
const { langue } = Astro.props;
const cabinet = getCabinet(langue);
const seo = getSeo(langue);
const l = t(langue);

/* Le mot mis en valeur est isole du reste du titre.
   Tant que le titre n'est pas redige, il s'affiche d'un bloc en dore
   plutot que decoupe autour d'un accent lui-meme a completer. */
const accent = cabinet.accrocheAccent;
const titreARediger =
  cabinet.accroche.startsWith(MARQUEUR) || accent.startsWith(MARQUEUR);
const morceaux = !titreARediger && accent && cabinet.accroche.includes(accent)
  ? cabinet.accroche.split(accent)
  : [cabinet.accroche, ''];
---
<Base langue={langue} page="accueil" titre={seo.accueil.titre} description={seo.accueil.description}>
  <section class="hero" style="border-top:0">
    <div class="wrap">
      <div class="duo-large">
        <div>
          <span class="mono">{l.accueilEyebrow} <Valeur v={cabinet.contact.ville} /></span>
          <h1>
            {titreARediger
              ? <Valeur v={cabinet.accroche} />
              : <Fragment>{morceaux[0]}<em>{accent}</em>{morceaux[1]}</Fragment>}
          </h1>
          <p class="intro"><Valeur v={cabinet.resume} /></p>
          <div class="actions">
            <a class="btn btn--plein" href={route('contact', langue)}>{l.ctaPrincipal}</a>
            <a class="btn btn--discret" href={route('approche', langue)}>{l.ctaMethode}</a>
          </div>
          <div class="trace" aria-hidden="true"></div>
        </div>
        <div class="fiche">
          <h3>{l.ficheCabinet}</h3>
          <dl>
            <dt>{l.fiche.structure}</dt><dd><Valeur v={cabinet.legal.formeJuridique} /></dd>
            <dt>{l.fiche.orias}</dt><dd><Valeur v={cabinet.legal.orias} /></dd>
            <dt>{l.fiche.statut}</dt><dd><Valeur v={cabinet.legal.statut} /></dd>
            <dt>{l.fiche.mandats}</dt><dd>{l.fiche.mandatsVal}</dd>
            <dt>{l.fiche.reporting}</dt><dd>{l.fiche.reportingVal}</dd>
            <dt>{l.fiche.premier}</dt><dd>{l.fiche.premierVal}</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <div class="preuves">
    {cabinet.preuves.map((p) => (
      <div class="preuve"><span class="mono"><Valeur v={p.titre} /></span><p><Valeur v={p.texte} /></p></div>
    ))}
  </div>

  <section class="bande--marine">
    <div class="wrap">
      <div class="titre-section"><span class="mono">01</span><h2>{l.missionsTitre}</h2></div>
      <p class="chapeau">{l.missionsChapeau}</p>
      <div class="grille grille--2" style="margin-top:32px">
        {cabinet.missions.map((m) => (
          <div class="case">
            <span class="mono"><Valeur v={m.etiquette} /></span>
            <h3><Valeur v={m.titre} /></h3>
            <p><Valeur v={m.texte} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="duo-large">
        <div>
          <span class="mono">{l.positionnement}</span>
          <h2 style="margin:14px 0 20px">{l.positionnementTitre}</h2>
          <p class="chapeau">{l.positionnementP1}</p>
          <p class="chapeau" style="margin-top:16px">{l.positionnementP2}</p>
          <div class="actions"><a class="btn btn--discret" href={route('parcours', langue)}>{l.ctaParcours}</a></div>
        </div>
        <div style="border-left:1px solid var(--rule);padding-left:clamp(20px,3vw,34px)">
          <p class="citation">{l.citation}<span class="src">{l.citationSource}</span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="bande--marine">
    <div class="wrap">
      <div class="titre-section"><span class="mono">02</span><h2>{l.faqTitre}</h2></div>
      <p class="chapeau">{l.faqChapeau}</p>
      <div class="faq">
        {cabinet.faq.map((q, i) => (
          <details open={i === 0}>
            <summary><Valeur v={q.question} /></summary>
            <p class="rep"><Valeur v={q.reponse} /></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap wrap--texte" style="text-align:center">
      <span class="mono">{l.premierEchange}</span>
      <h2 style="margin:16px 0 18px">{l.premierEchangeTitre}</h2>
      <p class="chapeau" style="margin:0 auto">{l.premierEchangeTexte}</p>
      <div class="actions" style="justify-content:center">
        <a class="btn btn--plein" href={route('contact', langue)}>{l.ctaRendezVous}</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cabinet.faq.map((q) => ({
      '@type': 'Question',
      name: nettoyer(q.question),
      acceptedAnswer: { '@type': 'Answer', text: nettoyer(q.reponse) },
    })),
  })} />
</Base>
