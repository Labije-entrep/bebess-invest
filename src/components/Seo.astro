---
import { getCabinet, languePubliee, nettoyer } from '../data';
import { LANGUES, CODE_HREFLANG, type Langue } from '../i18n/config';

interface Props {
  langue: Langue;
  titre: string;
  description: string;
  type?: string;
  /* Adresse de la meme page dans chaque langue. */
  alternatives: Partial<Record<Langue, string>>;
}
const props = Astro.props;
const { langue, type = 'website', alternatives } = props;
const titre = nettoyer(props.titre);
const description = nettoyer(props.description);
const cabinet = getCabinet(langue);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const titreComplet = `${titre} — ${cabinet.nom}`;

/* Une langue non publiee est construite pour relecture mais retiree
   des moteurs de recherche et du sitemap. */
const indexable = languePubliee(langue);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: cabinet.nom,
  description: nettoyer(cabinet.resume),
  url: Astro.site?.href,
  email: cabinet.contact.email,
  areaServed: 'FR',
  serviceType: "Conseil en gestion de portefeuilles d'actifs",
};
---
<title>{titreComplet}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{!indexable && <meta name="robots" content="noindex, nofollow" />}

{LANGUES.filter((l) => alternatives[l] && languePubliee(l)).map((l) => (
  <link rel="alternate" hreflang={CODE_HREFLANG[l]} href={new URL(alternatives[l]!, Astro.site).href} />
))}
{alternatives.fr && (
  <link rel="alternate" hreflang="x-default" href={new URL(alternatives.fr, Astro.site).href} />
)}

<meta property="og:type" content={type} />
<meta property="og:title" content={titreComplet} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={langue === 'fr' ? 'fr_FR' : 'en_GB'} />
<meta property="og:site_name" content={cabinet.nom} />
<meta property="og:image" content={new URL('/og.png', Astro.site).href} />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
