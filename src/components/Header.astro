---
import { getCabinet, languePubliee } from '../data';
import Valeur from './Valeur.astro';
import { MENU, route, t, LANGUES, NOM_LANGUE, type Langue, type Page } from '../i18n/config';

interface Props { langue: Langue; page: Page | 'note'; alternatives: Partial<Record<Langue, string>> }
const { langue, page, alternatives } = Astro.props;
const cabinet = getCabinet(langue);
const libelles = t(langue);

/* Le selecteur n'apparait que si une autre langue est reellement publiee. */
const autresLangues = LANGUES.filter(
  (l) => l !== langue && languePubliee(l) && alternatives[l]
);
---
<header class="site">
  <div class="wrap">
    <a class="marque" href={route('accueil', langue)}>
      <span class="sceau" aria-hidden="true">B</span>
      <span><b>{cabinet.nom}</b><i><Valeur v={cabinet.baseline} /></i></span>
    </a>
    <button class="burger" type="button" id="burger" aria-expanded="false" aria-controls="nav-principal">{libelles.ouvrirMenu}</button>
    <nav class="principal" id="nav-principal" aria-label="Navigation">
      {MENU.map((p) => (
        <a href={route(p, langue)} aria-current={p === page ? 'page' : undefined}>{libelles.menu[p]}</a>
      ))}
    </nav>
    {autresLangues.length > 0 && (
      <div class="langues">
        {autresLangues.map((l) => (
          <a href={alternatives[l]} hreflang={l} lang={l} title={libelles.changerLangue}>{l.toUpperCase()}</a>
        ))}
      </div>
    )}
    <a class="btn" href={route('contact', langue)}>{libelles.ctaEntete}</a>
  </div>
</header>
<script>
  const b = document.getElementById('burger');
  const n = document.getElementById('nav-principal');
  b?.addEventListener('click', () => {
    const ouvert = n?.classList.toggle('ouvert');
    b.setAttribute('aria-expanded', ouvert ? 'true' : 'false');
  });
</script>
