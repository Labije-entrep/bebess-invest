---
import type { Role } from '../../lib/db';
import { ABONNEMENT, aLeRole } from '../../lib/roles';
import { ONGLETS_REGLAGES } from '../../lib/onglets-reglages';
// Les rubriques des réglages. « Mon abonnement » n'y figure que pour l'associé : les autres ne reçoivent même pas le lien.
interface Props {
  /** La rubrique courante (clé de ONGLETS_REGLAGES), ou 'abonnement'. */
  courant: string;
  role: Role | undefined;
}
const { courant, role } = Astro.props;
---
<nav class="onglets" aria-label="Rubriques des réglages">
  {ONGLETS_REGLAGES.map(([k, nom]) => <a href={`/gestionnaire/reglages?onglet=${k}`} aria-current={courant === k ? 'page' : undefined}>{nom}</a>)}
  {aLeRole(role, ABONNEMENT) && <a href="/gestionnaire/reglages/abonnement" aria-current={courant === 'abonnement' ? 'page' : undefined}>Mon abonnement</a>}
</nav>
