---
// Cellule de tableau éditable : message d'erreur au-dessus du champ.
interface Props {
  nom: string;
  label: string;
  valeur?: string;
  erreur?: string;
  type?: string;
  num?: boolean;
  options?: [string, string][];
}
const { nom, label, valeur = '', erreur, type = 'text', num = false, options } = Astro.props;
---
<td class={num ? 'num' : undefined}>
  {erreur && <p class="erreur">{erreur}</p>}
  {
    options ? (
      <select class="champ" name={nom} aria-label={label}>
        <option value="">—</option>
        {valeur && !options.some(([k]) => k === valeur) && <option value={valeur} selected>{valeur}</option>}
        {options.map(([k, nom]) => <option value={k} selected={k === valeur}>{nom}</option>)}
      </select>
    ) : (
      <input class="champ" name={nom} type={type} value={valeur} aria-label={label} inputmode={num ? 'decimal' : undefined} />
    )
  }
</td>
