---
import Public from '../../layouts/Public.astro';
import { chaine, liste, paragraphes, type PageLue } from '../../lib/site';
import { T, type Lg } from '../../lib/publang';
import { envDe } from '../../lib/mail';
import { MENTIONS, mentionsDe } from '../../lib/reglages';

interface Props { langue: Lg; page: PageLue }
const { langue, page } = Astro.props;
const nom = Astro.locals.tenant?.nom ?? "BeBess'Invest";
const l = T[langue].legal;
// Les mentions viennent des réglages du cabinet (Réglages, Mentions légales) : raison sociale, ORIAS, statut, association
// agréée, médiateur, hébergeur, contact RGPD. Les intitulés sont fixes (publang, MENTIONS) ; aucun texte du cabinet n'est dans le code.
// Les sections libres de la page de contenu « mentions », si le cabinet en a écrit, s'ajoutent dessous.
const valeurs = Astro.locals.tenant ? await mentionsDe(envDe(Astro.locals).DB, Astro.locals.tenant.id) : {};
const champs = MENTIONS.filter((m) => valeurs[m.cle]);
const sections = liste(page.c?.sections);
const vide = champs.length === 0 && sections.length === 0;
---
<Public langue={langue} titre={page.titre ?? `${l.titre} · ${nom}`} description={page.description}>
  <section class="bloc-hero">
    <div class="wrap">
      <span class="etiquette">{chaine(page.c?.eyebrow) || l.etiquette}</span>
      <h1>{chaine(page.c?.titre) || l.titre}</h1>
      {vide ? (
        <div class="vide-explicite"><p>{l.vide}</p></div>
      ) : (
        <div class="prose">
          {champs.map((m) => (
            <>
              <h2>{langue === 'en' ? m.en : m.fr}</h2>
              {paragraphes(valeurs[m.cle]).map((p) => <p>{p}</p>)}
            </>
          ))}
          {sections.map((s) => (
            <>
              <h2>{chaine(s.titre)}</h2>
              {paragraphes(chaine(s.texte)).map((p) => <p>{p}</p>)}
            </>
          ))}
        </div>
      )}
    </div>
  </section>
</Public>
