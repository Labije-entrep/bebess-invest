---
export const prerender = false;
import Gestion from '../../../layouts/Gestion.astro';
import { accesCabinet, cabinetDe, configCloudflare, domainesDe, gardeAdmin, MESSAGES_ACTION, suspensionsDe, type CodeAction } from '../../../lib/admin';
import { accesDuCabinet } from '../../../lib/acces';
import { incidents, libelleIncident } from '../../../lib/incidents';
import { dateCourte } from '../../../lib/format';
import { identiteFacturation, identiteManquante, LIBELLES_IDENTITE } from '../../../lib/identite';
import { afficherSiren } from '../../../lib/siren';
import ContratCabinet from '../../../components/admin/ContratCabinet.astro';
import { compterFondateurs, contratEnCours, contratResilie } from '../../../lib/contrat';
import { MESSAGES_RETOUR } from '../../../lib/contrat-ecran';
import { apercuComplementaire, parrainagesValides } from '../../../lib/facturation';

const g = gardeAdmin(Astro);
if (g instanceof Response) return g;

const id = Astro.params.id ?? '';
const cabinet = await cabinetDe(g.db, id);
if (!cabinet) return new Response('Introuvable.', { status: 404 });
await accesCabinet(g, cabinet.id, `GET ${Astro.url.pathname}`);

const [domaines, acces, suspensions, recents, identite, contrat, fondateurs, valides, resilie] = await Promise.all([
  domainesDe(g.db, cabinet.id),
  accesDuCabinet(g.db, cabinet.id),
  suspensionsDe(g.db, cabinet.id),
  incidents(g.db, { tenantId: cabinet.id }, 5),
  identiteFacturation(g.db, cabinet.id),
  contratEnCours(g.db, cabinet.id),
  compterFondateurs(g.db),
  parrainagesValides(g.db, cabinet.id),
  contratResilie(g.db, cabinet.id),
]);
const manque = identite ? identiteManquante(identite) : [];
const cf = configCloudflare(g.env);
const base = `/admin/cabinets/${encodeURIComponent(cabinet.id)}`;
const q = Astro.url.searchParams;
// Le retour d'une action est un code (?r=), traduit ici par une table fixe : jamais du texte tiré de l'adresse.
const code = q.get('r') as CodeAction | null;
const retour = code && Object.hasOwn(MESSAGES_ACTION, code) ? { code, texte: MESSAGES_ACTION[code], bon: q.get('ok') === '1' } : null;
// Le retour d'une écriture du contrat (lot 14) : même principe, une autre table, et il s'affiche dans la rubrique « Contrat ».
const retourContrat = q.get('r') && Object.hasOwn(MESSAGES_RETOUR, q.get('r') as string) ? { texte: MESSAGES_RETOUR[q.get('r') as string], bon: q.get('ok') === '1' } : null;
// Le bon complémentaire attendu après l'activation d'un module : trois valeurs lues dans l'adresse, acceptées seulement si elles ont la forme attendue.
const attendu = /^\d{1,3}$/.test(q.get('mois') ?? '') && /^\d{1,10}$/.test(q.get('ht') ?? '') && /^\d{4}-\d{2}-\d{2}$/.test(q.get('jusqu') ?? '')
  ? { mois: Number(q.get('mois')), total_ht: Number(q.get('ht')), anniversaire: q.get('jusqu') as string }
  : null;
const jour = new Date().toISOString().slice(0, 10);
const apercus = {
  pilotage: contrat && !contrat.module_pilotage ? await apercuComplementaire(g.db, contrat, 'pilotage', jour) : null,
  site: contrat && !contrat.module_site ? await apercuComplementaire(g.db, contrat, 'site', jour) : null,
};
const envoye = q.get('envoye');
const suspension = suspensions.find((s) => !s.fin_le);
const horodate = (iso: string) => `${dateCourte(iso)} à ${iso.slice(11, 16)} UTC`;
---
<Gestion titre={cabinet.nom} espace="admin">
  <p class="aide"><a href="/admin">← Cabinets</a></p>
  <h1>{cabinet.nom}</h1>
  {q.get('cree') === '1' && <p class="info" role="status">Cabinet créé.</p>}
  {q.get('cree') === '1' && envoye === '1' && <p class="info" role="status">Le lien de première connexion a été envoyé au gestionnaire.</p>}
  {q.get('cree') === '1' && envoye === '0' && (
    <p class="info alerte" role="alert">Le cabinet est créé, mais le lien de première connexion n’a pas pu être envoyé. Le gestionnaire peut en demander un nouveau depuis la page de connexion du cabinet ; l’incident est noté ci-dessous.</p>
  )}
  {q.get('cree') === '1' && q.get('support') === 'non_configure' && (
    <p class="info alerte" role="alert">Aucun compte de support n’a été créé : l’adresse de support de l’éditeur n’est pas réglée. Réglez-la dans <a href="/admin/reglages">Réglages</a> ; elle vaudra pour les prochains cabinets.</p>
  )}
  {q.get('cree') === '1' && q.get('support') === 'adresse_prise' && (
    <p class="info alerte" role="alert">Aucun compte de support n’a été créé : l’adresse de support est celle du premier associé. Une adresse ne sert qu’à un compte par cabinet.</p>
  )}
  {q.get('cree') === '1' && q.get('support') === 'cree' && <p class="info" role="status">Le compte de support de l’éditeur a été créé.</p>}
  {retour && !retourContrat && <p class={retour.bon ? 'info' : 'info alerte'} role="status">{retour.texte}</p>}
  {suspension && (
    <p class="info alerte" role="status">
      <strong>Suspendu depuis le {horodate(suspension.debut_le)}</strong> — motif : {suspension.motif}. Le personnel du cabinet ne peut plus entrer ; les viewers consultent toujours leur espace.
    </p>
  )}

  <div class="kpis">
    <div class="kpi"><span class="etiquette">Viewers</span><span class="chiffre">{cabinet.viewers}</span></div>
    <div class="kpi"><span class="etiquette">Contacts</span><span class="chiffre">{cabinet.contacts}</span></div>
    <div class="kpi"><span class="etiquette">Arrêté le plus ancien</span><span class="chiffre">{cabinet.dernier_arrete ? dateCourte(cabinet.dernier_arrete) : '—'}</span></div>
    <div class="kpi"><span class="etiquette">Dernier incident</span><span class="chiffre">{cabinet.dernier_incident ? dateCourte(cabinet.dernier_incident) : '—'}</span></div>
  </div>

  <h2>Accès du cabinet</h2>
  {acces.length === 0 ? <p class="aide">Aucun accès.</p> : (
    <div class="defile">
      <table class="table">
        <thead><tr><th>Nom</th><th>Adresse</th><th>Rôle</th><th>Accès</th></tr></thead>
        <tbody>
          {acces.map((x) => (
            <tr><td>{x.nom}</td><td>{x.email}</td><td>{x.role}</td><td>{suspension ? 'Suspendu' : x.actif === 1 ? 'Actif' : 'Désactivé'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="aide">Associés, collaborateurs et lecture. Le compte de support de l’éditeur n’est jamais compté ni affiché ici.</p>

  <hr class="filet" />
  <ContratCabinet contrat={contrat} base={base} jour={jour} retour={retourContrat} attendu={attendu} fondateurs={fondateurs} parrainagesValides={valides} apercus={apercus} resilie={resilie} />

  <hr class="filet" />
  <h2>Facturation</h2>
  {manque.length > 0 && (
    <p class="info alerte" role="status">Identité de facturation incomplète : {manque.map((m) => LIBELLES_IDENTITE[m]).join(', ')} {manque.length > 1 ? 'manquent' : 'manque'}. Le bon à facturer le signale et ne s’émet pas sans confirmation.</p>
  )}
  <p class="aide">La raison sociale est le nom du cabinet : {cabinet.nom}. Le SIREN, l’adresse et le contact figurent sur chaque bon à facturer ; ils survivent à la suppression des données (J+75 d’un essai, J+30 d’une résiliation), avec la raison sociale.</p>
  <form method="post" action={`${base}/facturation`} style="max-width: 32rem">
    <div class="groupe">
      <label class="etiquette" for="siren">SIREN</label>
      <input class="champ" id="siren" name="siren" inputmode="numeric" maxlength="40" value={identite?.siren ? afficherSiren(identite.siren) : ''} />
      <p class="aide">Neuf chiffres, avec ou sans espaces. La clé de contrôle est vérifiée : un SIREN invalide est refusé.</p>
    </div>
    <div class="groupe">
      <label class="etiquette" for="adresse_facturation">Adresse de facturation</label>
      <textarea class="champ" id="adresse_facturation" name="adresse_facturation" rows="3" maxlength="400">{identite?.adresse_facturation ?? ''}</textarea>
    </div>
    <div class="groupe">
      <label class="etiquette" for="contact_facturation">Contact de facturation</label>
      <input class="champ" id="contact_facturation" name="contact_facturation" maxlength="200" value={identite?.contact_facturation ?? ''} />
    </div>
    <div class="actions"><button class="btn" type="submit">Enregistrer l’identité de facturation</button></div>
  </form>
  <p class="aide"><a href="/admin/facturation">Bons, contrats, remises et parrainages</a> · <a href={`${base}/journal`}>Journal d’événements de ce cabinet</a></p>

  <hr class="filet" />
  <h2>Domaines</h2>
  {!cf.jeton && (
    <p class="info alerte" role="alert">
      Jeton d’API Cloudflare absent (<code>CF_API_TOKEN</code>) : un domaine peut être déclaré et l’enregistrement CNAME s’affiche, mais Cloudflare n’est pas appelé et rien n’est validé. Le reste de la console fonctionne.
    </p>
  )}
  {cf.jeton && cf.manque.length > 0 && (
    <p class="info alerte" role="alert">Configuration Cloudflare incomplète : {cf.manque.join(', ')} manquant. {cf.zone ? '' : 'Sans zone, Cloudflare n’est pas appelé. '}</p>
  )}
  <p class="aide">Un nom d’hôte déclaré n’ouvre le cabinet qu’une fois validé par Cloudflare. Le cabinet pose chez son hébergeur DNS l’enregistrement CNAME indiqué.</p>
  <div class="defile">
    <table class="table">
      <thead><tr><th>Nom d’hôte</th><th>Enregistrement CNAME à poser</th><th>Validation</th><th></th></tr></thead>
      <tbody>
        {domaines.map((d) => (
          <tr>
            <td>{d.hote}{d.principal === 1 && <><br /><span class="aide">hôte d’origine</span></>}</td>
            <td>{d.principal === 1 ? '—' : <code>{d.hote} CNAME {cf.cible ?? '(cible non configurée : CF_CNAME_CIBLE)'}</code>}</td>
            <td class={d.statut === 'erreur' ? 'perime' : undefined}>
              {d.valide_le ? `Validé le ${dateCourte(d.valide_le)}` : d.statut === 'erreur' ? 'En erreur' : 'En attente'}
              {d.detail && !d.valide_le && <><br /><span class="aide">{d.detail}</span></>}
              {d.verifie_le && !d.valide_le && <><br /><span class="aide">Vérifié le {horodate(d.verifie_le)}</span></>}
            </td>
            <td class="num">
              {d.principal === 0 && (
                <>
                  <form method="post" action={`${base}/domaines`} style="display:inline">
                    <input type="hidden" name="action" value="verifier" /><input type="hidden" name="hote" value={d.hote} />
                    <button class="btn" type="submit">Vérifier</button>
                  </form>
                  <form method="post" action={`${base}/domaines`} style="display:inline">
                    <input type="hidden" name="action" value="retirer" /><input type="hidden" name="hote" value={d.hote} />
                    <button class="btn" type="submit">Retirer</button>
                  </form>
                </>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <form method="post" action={`${base}/domaines`} class="actions">
    <input type="hidden" name="action" value="declarer" />
    <label class="etiquette" for="nouvel-hote">Nouveau nom d’hôte</label>
    <input class="champ" id="nouvel-hote" name="hote" required maxlength="253" style="max-width: 24rem" placeholder="patrimoine.cabinet.fr" />
    <button class="btn" type="submit">Déclarer</button>
  </form>

  <hr class="filet" />
  <h2>Derniers incidents</h2>
  {recents.length === 0 ? <p class="aide">Aucun incident.</p> : (
    <div class="defile">
      <table class="table">
        <thead><tr><th>Date</th><th>Type</th><th>Détail</th></tr></thead>
        <tbody>
          {recents.map((i) => <tr><td>{horodate(i.cree_le)}</td><td>{libelleIncident(i.type)}</td><td>{i.detail ?? '—'}</td></tr>)}
        </tbody>
      </table>
    </div>
  )}
  <p class="aide"><a href={`/admin/incidents?cabinet=${encodeURIComponent(cabinet.id)}`}>Tous les incidents de ce cabinet</a></p>

  <hr class="filet" />
  <h2>Sortie</h2>
  <p class="aide">L’export complet du cabinet : une archive ZIP, un fichier CSV par table, les mêmes que la sortie de fin de contrat du gestionnaire.</p>
  <div class="actions">
    <a class="btn" href={`${base}/export`} download>Exporter tout le cabinet</a>
  </div>

  <h2 style="margin-top: var(--espace-l)">Suspension</h2>
  <p class="aide">La suspension rend inopérants les accès du personnel du cabinet (associés, collaborateurs, lecture) : connexion et sessions déjà ouvertes. Elle laisse en ligne et consultables les espaces de ses clients finaux, qui ne sont pas partie au litige commercial. Rien n’est effacé. Aucune suspension n’est jamais automatique.</p>
  {suspension ? (
    <form method="post" action={`${base}/suspension`} class="actions">
      <input type="hidden" name="action" value="lever" />
      <button class="btn" type="submit">Lever la suspension</button>
    </form>
  ) : (
    <form method="post" action={`${base}/suspension`} style="max-width: 32rem">
      <input type="hidden" name="action" value="suspendre" />
      <div class="groupe">
        <label class="etiquette" for="motif">Motif de la suspension *</label>
        <textarea class="champ" id="motif" name="motif" rows="3" required maxlength="500"></textarea>
      </div>
      <div class="actions"><button class="btn-plein" type="submit">Suspendre le cabinet</button></div>
    </form>
  )}
  {suspensions.length > 0 && (
    <div class="defile">
      <table class="table">
        <thead><tr><th>Depuis</th><th>Motif</th><th>Posée par</th><th>Levée</th></tr></thead>
        <tbody>
          {suspensions.map((s) => (
            <tr>
              <td>{horodate(s.debut_le)}</td><td>{s.motif}</td><td>{s.par_nom ?? '—'}</td>
              <td>{s.fin_le ? `${horodate(s.fin_le)}${s.fin_par_nom ? ` par ${s.fin_par_nom}` : ''}` : 'En cours'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Gestion>
