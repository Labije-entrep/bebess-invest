---
import Connexion from '../../layouts/Connexion.astro';
import { accueilDuRole, consommerJeton, jetonValide } from '../../lib/auth';
import { envDe } from '../../lib/mail';

// Le GET lit le jeton (jetonValide) pour afficher tout de suite un lien expiré ou déjà
// utilisé, mais ne l'écrit pas : un aperçu de lien ou un scanner de messagerie ne le
// consomme pas. Seul le POST, déclenché par le bouton, consomme.
const { DB } = envDe(Astro.locals);
const tenant = Astro.locals.tenant;
const jeton = Astro.params.jeton ?? '';

let invalide = false;
// ?refus=1 : le POST a été refusé avant la page (src/worker.ts). Le jeton n'a pas été consommé,
// mais ce navigateur n'a pas pu confirmer : on explique et on propose un nouveau lien.
const refuse = Astro.request.method === 'GET' && Astro.url.searchParams.get('refus') === '1';
if (Astro.request.method === 'POST') {
  const utilisateur = tenant ? await consommerJeton(DB, Astro.cookies, jeton, tenant.id) : null;
  if (utilisateur) {
    return Astro.redirect(accueilDuRole(utilisateur.role), 303);
  }
  invalide = true;
} else {
  invalide = !(tenant && (await jetonValide(DB, jeton, tenant.id)));
}
---

{
  refuse ? (
    <Connexion titre="Connexion non confirmée">
      <h1>La connexion n'a pas pu être confirmée</h1>
      <p>Votre navigateur n'a pas pu valider ce lien. Rien n'a été modifié : demandez-en un nouveau.</p>
      <p>
        <a class="btn" href="/connexion">Demander un nouveau lien</a>
      </p>
    </Connexion>
  ) : invalide ? (
    <Connexion titre="Lien expiré">
      <h1>Ce lien n'est plus valable</h1>
      <p>Il a expiré, a déjà été utilisé ou n'est pas reconnu. Demandez-en un nouveau.</p>
      <p>
        <a class="btn" href="/connexion">Demander un nouveau lien</a>
      </p>
    </Connexion>
  ) : (
    <Connexion titre="Confirmer la connexion">
      <h1>Confirmer la connexion</h1>
      <p>Pour ouvrir votre espace, confirmez la connexion.</p>
      <form method="post" action={Astro.url.pathname}>
        <button class="btn-plein" type="submit">Confirmer la connexion</button>
      </form>
    </Connexion>
  )
}
