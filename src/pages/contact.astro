---
import Public from '../layouts/Public.astro';
import PubVide from '../components/PubVide.astro';
import { envDe, creerMailer } from '../lib/mail';
import { chargerPage, chaine, paragraphes } from '../lib/site';

const env = envDe(Astro.locals);
const tenant = Astro.locals.tenant;
const nom = tenant?.nom ?? "BeBess'Invest";
const page = await chargerPage(env.DB, tenant?.id, 'contact');
const c = page.c;

const vals = { nom: '', email: '', telephone: '', objet: '', message: '' };
const erreurs: Record<string, string> = {};
let general = '';

if (Astro.request.method === 'POST' && tenant) {
  const f = await Astro.request.formData();
  const lire = (k: string) => String(f.get(k) ?? '').trim();
  vals.nom = lire('nom');
  vals.email = lire('email');
  vals.telephone = lire('telephone');
  vals.objet = lire('objet');
  vals.message = lire('message');

  // Champ piège : un robot le remplit, un humain ne le voit pas.
  if (lire('site')) return Astro.redirect('/contact?envoye=1', 303);

  if (!vals.nom || vals.nom.length > 200) erreurs.nom = 'Indiquez votre nom.';
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(vals.email) || vals.email.length > 200) erreurs.email = 'Indiquez une adresse e-mail valide.';
  if (vals.telephone.length > 50) erreurs.telephone = 'Numéro trop long.';
  if (!vals.objet || vals.objet.length > 200) erreurs.objet = "Indiquez l'objet de votre message.";
  if (!vals.message || vals.message.length > 5000) erreurs.message = 'Écrivez votre message (5 000 caractères au plus).';
  if (f.get('consentement') !== 'oui') erreurs.consentement = 'Votre accord est nécessaire pour traiter votre demande.';

  if (Object.keys(erreurs).length === 0) {
    // Aucun repli silencieux : l'adresse de réception se règle dans Contenus > Contact.
    const destinataire = chaine(c?.destinataire).trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(destinataire)) {
      general = "Le message n'a pas pu être envoyé : aucune adresse de réception n'est configurée.";
    } else {
      try {
        const texte = [
          `Nom : ${vals.nom}`,
          `E-mail : ${vals.email}`,
          `Téléphone : ${vals.telephone || 'non renseigné'}`,
          '',
          vals.message,
        ].join('\n');
        await creerMailer(env).envoyer(destinataire, `Contact : ${vals.objet.replace(/\s+/g, ' ')}`, texte);
        return Astro.redirect('/contact?envoye=1', 303);
      } catch {
        general = "Le message n'a pas pu être envoyé. Réessayez dans un instant.";
      }
    }
  }
}

const envoye = Astro.url.searchParams.get('envoye') === '1';
const conf = c?.confirmation ?? {};
const coord = c?.coordonnees ?? {};
---
<Public titre={page.titre ?? `Contact · ${nom}`} description={page.description}>
  {envoye ? (
    <section class="bloc-hero">
      <div class="wrap">
        <span class="etiquette">Message envoyé</span>
        <h1>{chaine(conf.titre) || 'Merci, votre message est parti.'}</h1>
        <p>{chaine(conf.texte) || 'Nous vous répondons dès que possible.'}</p>
        <div class="actions-pub"><a class="btn" href="/">Retour à l'accueil</a></div>
      </div>
    </section>
  ) : !c ? <PubVide cle="contact" /> : (
    <section class="bloc-hero">
      <div class="wrap deux">
        <div class="coord">
          {chaine(c.eyebrow) && <span class="etiquette">{c.eyebrow}</span>}
          <h1>{chaine(c.titre)}</h1>
          {chaine(c.intro) && <p>{c.intro}</p>}
          {chaine(coord.adresse) && <p>{coord.adresse}</p>}
          {chaine(coord.telephone) && <p>{coord.telephone}</p>}
          {paragraphes(chaine(coord.horaires)).map((h) => <p>{h}</p>)}
        </div>
        <form class="formulaire" method="post" action="/contact" novalidate>
          {general && <p class="erreur">{general}</p>}
          <div class="piege" aria-hidden="true"><label>Ne pas remplir <input type="text" name="site" tabindex="-1" autocomplete="off" /></label></div>
          <div class="groupe">
            <label class="etiquette" for="nom">Nom</label>
            <input class="champ" id="nom" name="nom" type="text" autocomplete="name" required value={vals.nom} />
            {erreurs.nom && <p class="erreur">{erreurs.nom}</p>}
          </div>
          <div class="groupe">
            <label class="etiquette" for="email">E-mail</label>
            <input class="champ" id="email" name="email" type="email" autocomplete="email" required value={vals.email} />
            {erreurs.email && <p class="erreur">{erreurs.email}</p>}
          </div>
          <div class="groupe">
            <label class="etiquette" for="telephone">Téléphone</label>
            <input class="champ" id="telephone" name="telephone" type="tel" autocomplete="tel" value={vals.telephone} />
            {erreurs.telephone && <p class="erreur">{erreurs.telephone}</p>}
          </div>
          <div class="groupe">
            <label class="etiquette" for="objet">Objet</label>
            <input class="champ" id="objet" name="objet" type="text" required value={vals.objet} />
            {erreurs.objet && <p class="erreur">{erreurs.objet}</p>}
          </div>
          <div class="groupe">
            <label class="etiquette" for="message">Message</label>
            <textarea class="champ" id="message" name="message" rows="7" required>{vals.message}</textarea>
            {erreurs.message && <p class="erreur">{erreurs.message}</p>}
          </div>
          <div class="groupe">
            <label class="consent">
              <input type="checkbox" name="consentement" value="oui" required />
              <span>J'accepte que ces informations soient utilisées pour répondre à ma demande.</span>
            </label>
            {erreurs.consentement && <p class="erreur">{erreurs.consentement}</p>}
          </div>
          <button class="btn-plein" type="submit">Envoyer</button>
        </form>
      </div>
    </section>
  )}
</Public>
