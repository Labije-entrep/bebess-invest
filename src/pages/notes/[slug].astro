---
import Note from '../../components/pub/Note.astro';
import { envDe } from '../../lib/mail';
import { notePubliee } from '../../lib/site';

const tenant = Astro.locals.tenant;
const note = tenant && Astro.params.slug ? await notePubliee(envDe(Astro.locals).DB, tenant.id, Astro.params.slug) : null;
if (!note) return Astro.rewrite('/404');
---
<Note langue="fr" note={note} />
