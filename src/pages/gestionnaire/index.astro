---
export const prerender = false;
import Gestion from '../../layouts/Gestion.astro';
import { contexte, viewersResumes, dernierImport, seuilArrete } from '../../lib/gestion';
import { seuilsDe } from '../../lib/suivi';
import { euros, dateCourte } from '../../lib/format';
import { urlLogoCabinet, MESSAGES_REFUS } from '../../lib/fichiers';
import { EXPORT_COMPLET_CABINET, aLeRole } from '../../lib/roles';

const c = contexte(Astro);
if (c instanceof Response) return c;

const viewers = await viewersResumes(c.db, c.tenant.id);
const dernier = await dernierImport(c.db, c.tenant.id);
const joursArrete = (await seuilsDe(c.db, c.tenant.id)).arrete; // réglage « arrêté périmé » du cabinet (45 jours par défaut)
const seuil = seuilArrete(joursArrete);
// Rappel calculé au chargement : viewers actifs dont l'arrêté dépasse le seuil. Ni tâche planifiée, ni e-mail.
const enRetard = viewers.filter((v) => v.actif === 1 && (!v.arrete || v.arrete < seuil));
const encours =viewers.reduce((s, v) => s + v.encours, 0);
const actifs = viewers.filter((v) => v.actif === 1).length;
const arretes = viewers.map((v) => v.arrete).filter((d): d is string => !!d).sort();
const derniere = arretes.length ? arretes[arretes.length - 1] : null;
const importe = Astro.url.searchParams.get('importe') === '1';
const logo = await urlLogoCabinet(c.db, c.tenant.id);
const retourLogo = Astro.url.searchParams.get('logo') ?? '';
const MSG_LOGO: Record<string, string> = { ok: 'Logo du cabinet enregistré.', retire: 'Logo du cabinet retiré.', ...MESSAGES_REFUS };
---
<Gestion titre="Tableau de bord">
  <h1>Tableau de bord</h1>
  {importe && <p class="info">Import enregistré.</p>}
  {MSG_LOGO[retourLogo] && <p class={retourLogo in MESSAGES_REFUS ? 'info alerte' : 'info'} role="status">{MSG_LOGO[retourLogo]}</p>}
  {enRetard.length > 0 && (
    <div class="info alerte" role="status">
      <strong>{enRetard.length} viewer{enRetard.length > 1 ? 's' : ''} à mettre à jour</strong> : arrêté de plus de {joursArrete} jours ou absent.
      <ul>
        {enRetard.map((v) => (
          <li>
            <a href={`/gestionnaire/viewers/${encodeURIComponent(v.id)}?onglet=arrete`}>{v.nom}</a>
            {' '}— {v.arrete ? `arrêté au ${dateCourte(v.arrete)}` : 'aucun arrêté'}
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="kpis">
    <div class="kpi"><span class="etiquette">Encours suivis</span><span class="chiffre">{euros(encours)}</span></div>
    <div class="kpi"><span class="etiquette">Viewers</span><span class="chiffre">{viewers.length}</span></div>
    <div class="kpi"><span class="etiquette">Accès actifs</span><span class="chiffre">{actifs} / {viewers.length}</span></div>
    <div class="kpi"><span class="etiquette">Dernière valorisation</span><span class="chiffre">{derniere ? dateCourte(derniere) : '—'}</span></div>
  </div>

  <h2>Viewers</h2>
  {
    viewers.length === 0 ? (
      <p>Aucun viewer pour l'instant. <a href="/gestionnaire/viewers/nouveau">Créer le premier</a>.</p>
    ) : (
      <div class="defile">
        <table class="table">
          <thead>
            <tr><th>Nom</th><th class="num">Encours</th><th>Arrêté au</th><th>Accès</th></tr>
          </thead>
          <tbody>
            {viewers.map((v) => (
              <tr>
                <td><a href={`/gestionnaire/viewers/${encodeURIComponent(v.id)}`}>{v.nom}</a></td>
                <td class="num">{euros(v.encours)}</td>
                <td class={!v.arrete || v.arrete < seuil ? 'perime' : undefined}>{v.arrete ? dateCourte(v.arrete) : 'Aucun'}</td>
                <td>{v.actif === 1 ? 'Actif' : 'Suspendu'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <hr class="filet" />
  <span class="etiquette">Dernier import CSV</span>
  <p>{dernier ? `${dernier.nom_fichier} — ${dernier.lignes} ligne${dernier.lignes > 1 ? 's' : ''} traitée${dernier.lignes > 1 ? 's' : ''}, le ${dateCourte(dernier.cree_le)}` : 'Aucun import pour l\'instant.'}</p>
  <div class="actions">
    <a class="btn-plein" href="/gestionnaire/viewers/nouveau">Nouveau viewer</a>
    <a class="btn" href="/gestionnaire/import">Importer un CSV</a>
  </div>

  <hr class="filet" />
  <span class="etiquette">Logo du cabinet</span>
  <p class="aide">Affiché sur le site et dans l'espace des clients. PNG, JPEG ou WebP, 512 Ko au plus.</p>
  {logo && <p><img src={logo} alt="Logo actuel" height="48" /></p>}
  <form method="post" action="/gestionnaire/fichiers/logo-cabinet" enctype="multipart/form-data" class="actions">
    <input name="fichier" type="file" accept="image/png,image/jpeg,image/webp" required aria-label="Fichier du logo" />
    <button class="btn" type="submit">Enregistrer le logo</button>
  </form>
  {logo && (
    <form method="post" action="/gestionnaire/fichiers/logo-cabinet" enctype="multipart/form-data" class="actions">
      <input type="hidden" name="action" value="retirer" />
      <button class="btn" type="submit">Retirer le logo</button>
    </form>
  )}

  <hr class="filet" />
  <span class="etiquette">Exports</span>
  <p class="aide">Fichiers CSV (séparateur point-virgule, UTF-8, ouverts par Excel). Montants en centimes, dates ISO 8601.</p>
  <div class="actions">
    <a class="btn" href="/gestionnaire/export/contacts" download>Contacts</a>
    <a class="btn" href="/gestionnaire/export/sujets" download>Sujets</a>
    <a class="btn" href="/gestionnaire/export/echanges" download>Échanges</a>
    <a class="btn" href="/gestionnaire/export/actus" download>Actus</a>
    {aLeRole(c.utilisateur.role, EXPORT_COMPLET_CABINET) && <a class="btn" href="/gestionnaire/export/locataire" download>Tout le cabinet (fin de contrat)</a>}
  </div>
</Gestion>
