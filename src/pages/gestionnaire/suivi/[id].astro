---
export const prerender = false;
import Gestion from '../../../layouts/Gestion.astro';
import { envDe } from '../../../lib/mail';
import { arretesPerimes, ecartsHorsSeuil, panneauPortail } from '../../../lib/fiche';
import { classesAvecEcartOuvert } from '../../../lib/passerelle';
import { dateLongue, euros, pourcent } from '../../../lib/format';
import { signeBp, teinte } from '../../../lib/espace';
import { CABINET_ECRIT, aLeRole } from '../../../lib/roles';

// Fiche d'un contact. Colonne principale : rendue côté client par src/scripts/fiche.ts, qui parle à
// /api/suivi (édition optimiste). Colonne Portail : rendue ici, au serveur, en lecture seule.
// L'accès est gardé par le middleware (gestionnaire, éditeur) ; le contact doit être du locataire.
const { utilisateur, tenant } = Astro.locals;
if (!utilisateur || !tenant) return Astro.redirect('/connexion');

const db = envDe(Astro.locals).DB;
const id = Astro.params.id ?? '';
const contact =
  id.length > 0 && id.length <= 64
    ? await db
        .prepare('SELECT id, nom, prenom, viewer_id, logo_cle FROM contact WHERE id = ? AND tenant_id = ?')
        .bind(id, tenant.id)
        .first<{ id: string; nom: string; prenom: string | null; viewer_id: string | null; logo_cle: string | null }>()
    : null;
if (!contact) return Astro.rewrite('/404');

const portail = contact.viewer_id ? await panneauPortail(db, tenant.id, contact.viewer_id) : null;
const plusieurs = portail ? portail.portefeuilles.length > 1 : false;
const depasse = (ecartBp: number | null): boolean => ecartBp !== null && portail !== null && Math.abs(ecartBp) > portail.seuilEcartBp;
const horsSeuil = portail
  ? portail.portefeuilles.flatMap((b) => b.classes.filter((c) => depasse(c.ecartBp)).map((c) => portail.libellesClasses[c.classe] ?? c.classe))
  : [];
const visite = portail?.derniereVisite ? dateLongue(portail.derniereVisite.slice(0, 10)) : null;

// Passerelle (lot 07) : les boutons ne se déclenchent que par un geste ; les routes recalculent ce qu'elles écrivent.
const estGestionnaire = aLeRole(utilisateur.role, CABINET_ECRIT); // associé, collaborateur, support : pas `lecture`, pas l'éditeur
const ecarts = portail ? ecartsHorsSeuil(portail) : [];
// Un sujet d'écart non clos pour la classe : le bouton est grisé (la route le refuse aussi, en doublure) ; clos, il redevient actif.
const ecartsOuverts = portail ? await classesAvecEcartOuvert(db, tenant.id, contact.id) : new Set<string>();
const perimes = portail ? arretesPerimes(portail) : [];
const actionSujet = `/gestionnaire/passerelle/sujet/${encodeURIComponent(contact.id)}`;
const actionPromotion = `/gestionnaire/passerelle/promotion/${encodeURIComponent(contact.id)}`;
const sansPoints = (bp: number): string => (bp / 100).toLocaleString('fr-FR');
// Messages de retour : textes fixes choisis par code (rien de ce qui est dans l'adresse n'est affiché).
const MESSAGES: Record<string, [string, boolean]> = {
  promu: ['Contact promu : le viewer, sa fiche et son portefeuille « Patrimoine » sont créés, et le lien de première connexion est envoyé.', false],
  promu_sans_envoi: ['Contact promu : le viewer, sa fiche et son portefeuille « Patrimoine » sont créés et rattachés, mais le lien de première connexion n’a pas pu être envoyé. La personne peut demander un lien depuis la page de connexion ; le journal du serveur donne la cause.', true],
  email_absent: ['Ce contact n’a pas d’adresse e-mail, et le lien de première connexion part par e-mail : il ne peut pas être promu. Renseignez l’adresse dans la fiche, puis recommencez.', true],
  email_invalide: ['L’adresse e-mail de ce contact n’est pas valable : corrigez-la dans la fiche, puis recommencez.', true],
  type_absent: ['Aucun type de portefeuille n’est marqué « Type par défaut » : le portefeuille de départ n’aurait pas de type, rien n’a été créé. Posez le marqueur dans Réglages, Listes.', true],
  email_pris: ['Cette adresse e-mail est déjà celle d’un compte : ce contact ne peut pas être promu avec elle.', true],
  deja: ['Ce contact est déjà rattaché à un viewer.', false],
  sans_viewer: ['Ce contact n’est rattaché à aucun viewer : il n’y a ni écart ni arrêté à signaler.', true],
  sujet_cree: ['Sujet créé sur ce contact : il est dans la liste des sujets, à son premier statut.', false],
  sujet_existant: ['Un sujet non clos existe déjà pour cela : le voici, aucun doublon n’a été créé.', false],
  ecart_sous_seuil: ['Cet écart ne dépasse plus le seuil : aucun sujet n’a été créé.', true],
  arrete_a_jour: ['Cet arrêté n’est plus périmé : aucun sujet n’a été créé.', true],
  statut_absent: ['Le cabinet n’a aucun statut de sujet qui ne soit pas terminal : le sujet n’a pas été créé.', true],
  logo_ok: ['Logo enregistré.', false],
  logo_retire: ['Logo retiré.', false],
  logo_absent: ['Aucun fichier reçu.', true],
  logo_vide: ['Le fichier est vide.', true],
  logo_trop_gros: ['Le logo dépasse 512 Ko.', true],
  logo_type_refuse: ['Le contenu du fichier n’est pas une image PNG, JPEG ou WebP, quelle que soit son extension.', true],
  demande_inconnue: ['Demande inconnue : aucun sujet n’a été créé.', true],
};
const retour = MESSAGES[Astro.url.searchParams.get('pm') ?? ''] ?? null;
---
<Gestion titre={`Fiche · ${contact.nom}`}>
  <div class="fiche" id="fiche" data-id={contact.id}>
    <div class="fiche-entete">
      <a class="fiche-retour" href="/gestionnaire/suivi">← Tous les contacts</a>
      <p id="fiche-etat" class="fiche-etat" role="status" aria-live="polite" data-etat="chargement">
        <span class="fiche-point" aria-hidden="true"></span><span data-texte>Chargement…</span>
      </p>
    </div>
    <div id="fiche-alertes" class="fiche-alertes" aria-live="polite"></div>
    {retour && <p class={retour[1] ? 'info alerte' : 'info'} role={retour[1] ? 'alert' : 'status'}>{retour[0]}</p>}

    <div class="fiche-fichiers">
      {contact.logo_cle && <img src={`/fichiers/contact/${encodeURIComponent(contact.id)}`} alt={`Logo de ${contact.nom}`} height="48" />}
      <form method="post" action={`/gestionnaire/fichiers/logo-contact/${encodeURIComponent(contact.id)}`} enctype="multipart/form-data">
        <label class="etiquette" for="logo-contact">Logo (PNG, JPEG ou WebP, 512 Ko)</label>
        <input id="logo-contact" name="fichier" type="file" accept="image/png,image/jpeg,image/webp" required />
        <button class="btn" type="submit">Enregistrer le logo</button>
      </form>
      {contact.logo_cle && (
        <form method="post" action={`/gestionnaire/fichiers/logo-contact/${encodeURIComponent(contact.id)}`} enctype="multipart/form-data">
          <input type="hidden" name="action" value="retirer" />
          <button class="btn" type="submit">Retirer le logo</button>
        </form>
      )}
      <a class="btn" href={`/gestionnaire/export/contact/${encodeURIComponent(contact.id)}`} download>Exporter ce contact (accès RGPD)</a>
    </div>

    <div class="fiche-cadre">
      <div class="fiche-principal" id="fiche-corps">
        <noscript><p class="info alerte">La fiche demande JavaScript.</p></noscript>
      </div>

      <aside class="fiche-aside" aria-label="Portail">
        {portail ? (
          <div class="portail-carte">
            <p class="etiquette portail-etiquette">Portail</p>
            <p class="portail-viewer">Viewer rattaché : <span>{portail.viewer.nom}</span></p>

            <p class="etiquette">Total</p>
            <p class="portail-total">{euros(portail.totalCents)}</p>
            <p class="portail-sous">
              {portail.arrete ? `Somme des enveloppes, arrêtée au ${dateLongue(portail.arrete)}` : 'Aucun arrêté pour l’instant'}
            </p>

            {portail.portefeuilles.length > 0 && (
              <ul class="portail-pf" aria-label="Portefeuilles">
                {portail.portefeuilles.map((b) => (
                  <li><span>{b.libelle}</span><span class="num">{euros(b.totalCents)}</span></li>
                ))}
              </ul>
            )}

            <div class="portail-doubles">
              <div>
                <p class="etiquette">Performance{portail.annee ? ` ${portail.annee}` : ''}</p>
                <p class={`portail-valeur ${teinte(portail.perfBp)}`}>{portail.perfBp === null ? '—' : signeBp(portail.perfBp)}</p>
                <p class="portail-sous">
                  {portail.perfOrigineBp === null ? 'Pondérée par le temps' : `Depuis l’origine : ${signeBp(portail.perfOrigineBp)}`}
                </p>
              </div>
              <div>
                <p class="etiquette">Accès</p>
                <p class="portail-valeur portail-texte">{visite ? `Vu le ${visite}` : 'Aucune visite'}</p>
              </div>
            </div>

            {portail.portefeuilles.some((b) => b.classes.length > 0) && (
              <>
                <p class="etiquette portail-titre-repartition">Réel contre cible</p>
                {portail.portefeuilles.map((b) => b.classes.length > 0 && (
                  <div class="portail-repartition">
                    {plusieurs && <p class="portail-pf-titre">{b.libelle}</p>}
                    {b.classes.map((c, i) => {
                      const hors = depasse(c.ecartBp);
                      return (
                        <div class="portail-classe">
                          <span class="portail-nom">{portail.libellesClasses[c.classe] ?? c.classe}</span>
                          <span class="portail-barre" role="img" aria-label={`${portail.libellesClasses[c.classe] ?? c.classe} : ${pourcent(c.partBp)}${c.cibleBp !== null ? `, cible ${pourcent(c.cibleBp)}` : ', sans cible'}`}>
                            <span class={`portail-part${hors ? ' hors' : ''}`} style={`width:${Math.min(100, c.partBp / 100)}%;${hors ? '' : ` background: var(--serie-${(i % 5) + 1});`}`}></span>
                            {c.cibleBp !== null && <span class="portail-cible" style={`left:${Math.min(100, c.cibleBp / 100)}%`}></span>}
                          </span>
                          <span class={`portail-chiffres${hors ? ' hors' : ''}`}>
                            {pourcent(c.partBp)}
                            {c.ecartBp !== null && <span class="portail-ecart">{signeBp(c.ecartBp)}</span>}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                ))}
                <p class="portail-sous portail-legende">
                  Le trait clair marque la cible ; l’écart est en points.
                  {horsSeuil.length > 0 && ` Au-delà du seuil de ${(portail.seuilEcartBp / 100).toLocaleString('fr-FR')} points : ${[...new Set(horsSeuil)].join(', ')}.`}
                </p>
              </>
            )}

            {ecarts.length > 0 ? (
              <>
                {ecarts.map((e) => (
                  <form method="post" action={actionSujet}>
                    <input type="hidden" name="type" value="ecart" />
                    <input type="hidden" name="cle" value={e.classe} />
                    {ecartsOuverts.has(e.classe) ? (
                      <span title="Sujet déjà existant, non clos">
                        <button type="submit" class="btn-plein portail-action" disabled aria-disabled="true" aria-describedby={`ecart-ouvert-${e.classe}`} title="Sujet déjà existant, non clos" data-ecart-grise>Créer un sujet depuis l’écart{ecarts.length > 1 ? ` · ${e.libelle}` : ''}</button>
                        <span class="portail-sous portail-aide" id={`ecart-ouvert-${e.classe}`}>Sujet déjà existant, non clos.</span>
                      </span>
                    ) : (
                      <button type="submit" class="btn-plein portail-action">Créer un sujet depuis l’écart{ecarts.length > 1 ? ` · ${e.libelle}` : ''}</button>
                    )}
                  </form>
                ))}
                <p class="portail-sous portail-aide">Crée un sujet sur ce contact, avec la classe, le réel et la cible. Tant qu’un sujet d’écart n’est pas clos pour cette classe, le bouton est grisé ; il redevient actif quand ce sujet est clos.</p>
              </>
            ) : (
              <p class="portail-sous portail-aide">Aucun écart au-delà du seuil de {sansPoints(portail.seuilEcartBp)} points : rien à transformer en sujet.</p>
            )}

            {perimes.length > 0 && (
              <>
                <p class="etiquette portail-titre-perime">Arrêté périmé</p>
                {perimes.map((b) => (
                  <form method="post" action={actionSujet}>
                    <input type="hidden" name="type" value="arrete" />
                    <input type="hidden" name="cle" value={b.id} />
                    <p class="portail-sous portail-aide">{plusieurs ? `${b.libelle} : ` : ''}dernier arrêté le {dateLongue(b.arrete)}, au-delà de {portail.seuilArreteJours} jours.</p>
                    <button type="submit" class="btn portail-action">Créer un sujet depuis l’arrêté périmé</button>
                  </form>
                ))}
              </>
            )}

            {estGestionnaire && (
              <a class="btn portail-action" href={`/gestionnaire/viewers/${encodeURIComponent(portail.viewer.id)}?onglet=arrete`}>Saisir le nouvel arrêté</a>
            )}
          </div>
        ) : (
          <div class="portail-vide">
            <p class="etiquette">Non rattaché</p>
            <p>Pour un contact sans accès au portail, ce panneau propose la promotion : le viewer, sa fiche et un portefeuille « Patrimoine » sont créés à partir des informations déjà saisies, et le lien de première connexion part aussitôt. Dès lors, les avoirs du contact sont calculés depuis ses portefeuilles et ne se saisissent plus.</p>
            {estGestionnaire ? (
              <form method="post" action={actionPromotion}>
                <p class="portail-aide">Le lien de première connexion part à l’adresse e-mail de la fiche : sans adresse, la promotion est refusée et le motif s’affiche.</p>
                <button type="submit" class="btn portail-action">Promouvoir en viewer</button>
              </form>
            ) : (
              <p>La promotion crée un accès client : elle est réservée aux rôles qui écrivent (associé, collaborateur).</p>
            )}
          </div>
        )}
      </aside>
    </div>
  </div>
  <script>
    import '../../../scripts/fiche';
  </script>
</Gestion>

<style is:global>
  .fiche-fichiers { display: flex; align-items: center; gap: var(--espace); flex-wrap: wrap; margin: var(--espace) 0; }
  .fiche-fichiers form { display: flex; align-items: center; gap: var(--espace-xs); flex-wrap: wrap; }
  .fiche-fichiers img { max-width: 12rem; object-fit: contain; }
  .fiche-entete { display: flex; align-items: baseline; justify-content: space-between; gap: var(--espace); flex-wrap: wrap; }
  .fiche-retour { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--texte-2); }
  .fiche-etat { display: flex; align-items: center; gap: var(--espace-xs); margin: 0; font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); }
  .fiche-point { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--texte-2); }
  .fiche-etat[data-etat='ajour'] .fiche-point { background: var(--positif); }
  .fiche-etat[data-etat='attente'] .fiche-point { background: var(--accent); }
  .fiche-etat[data-etat='refus'] .fiche-point, .fiche-etat[data-etat='horsligne'] .fiche-point { background: var(--alerte); }
  .fiche-etat[data-etat='refus'], .fiche-etat[data-etat='horsligne'] { color: var(--alerte); }
  .fiche-alertes:empty { display: none; }
  .fiche-alertes .info { margin-bottom: var(--espace-s); }

  .fiche-cadre { display: flex; flex-wrap: wrap; gap: var(--espace-xl); margin-top: var(--espace); }
  .fiche-principal { flex: 999 1 35rem; min-width: 0; }
  .fiche-aside { flex: 1 1 23.75rem; min-width: 0; }

  /* En-tête */
  .fiche-tete { display: flex; flex-wrap: wrap; gap: var(--espace-m); align-items: baseline; justify-content: space-between; }
  .fiche-principal h1 { margin: 0; font-weight: 200; font-size: 2.375rem; letter-spacing: -0.02em; }
  .fiche-contact { margin: 0.5rem 0 0; font-size: 0.875rem; color: var(--texte-2); display: flex; flex-wrap: wrap; gap: 0 0.5rem; align-items: baseline; }
  .fiche-types { display: flex; flex-wrap: wrap; gap: var(--espace-xs); }
  .fiche-type { font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); background: transparent; border: 1px solid var(--filet); padding: 0.375rem 0.625rem; cursor: pointer; }
  .fiche-type[aria-pressed='true'] { color: var(--accent-clair); border-color: var(--accent); }
  .fiche-bandeau { display: flex; flex-wrap: wrap; margin-top: var(--espace-l); padding: 1.125rem 0; border-top: 1px solid var(--filet); border-bottom: 1px solid var(--filet); }
  .fiche-cellule { flex: 1 1 10rem; min-width: 0; padding: 0 1.75rem; border-left: 1px solid var(--filet); }
  .fiche-cellule:first-child { padding-left: 0; border-left: 0; }
  .fiche-cellule:last-child { padding-right: 0; }
  .fiche-cellule .etiquette { margin-bottom: 0.4375rem; font-family: var(--mono); font-size: 0.5625rem; }
  .fiche-valeur { margin: 0; font-size: 0.875rem; }
  .fiche-avatar { display: inline-grid; place-items: center; width: 1.125rem; height: 1.125rem; border-radius: 50%; background: var(--filet); color: var(--texte); font-size: 0.5625rem; font-weight: 400; margin-right: 0.4375rem; vertical-align: middle; }
  .fiche-avatar.pleine { color: var(--sur-accent); }

  /* Champ modifiable en place */
  .fiche-champ { font: inherit; color: inherit; background: none; border: 0; border-bottom: 1px dashed transparent; padding: 0; margin: 0; cursor: text; text-align: left; }
  .fiche-champ:hover { border-bottom-color: var(--filet); }
  .fiche-champ .vide { color: var(--texte-2); }
  .fiche-saisie { font: inherit; padding: 0.25rem 0.4rem; color: var(--texte); border: 1px solid var(--accent); min-width: 6rem; max-width: 100%; }
  .fiche-saisie.large { width: 100%; }
  .fiche-lien-modif { font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); background: none; border: 0; padding: 0 0 0 0.5rem; cursor: pointer; }
  .fiche-lien-modif:hover { color: var(--accent-clair); }
  .fiche-erreur { display: block; margin-top: 0.25rem; font-size: 0.75rem; color: var(--alerte); }
  .fiche-marque { display: block; margin-top: 0.3125rem; font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-clair); }
  .fiche-marque.refus { color: var(--alerte); }
  .fiche-marque button { font: inherit; letter-spacing: inherit; text-transform: inherit; color: inherit; background: none; border: 0; padding: 0 0 0 0.5rem; cursor: pointer; text-decoration: underline; }

  /* Sujets et échanges */
  .fiche-bloc { margin-top: var(--espace-xl); }
  .fiche-bloc-tete { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--espace); }
  .fiche-bloc-tete h2 { margin: 0; font-weight: 300; font-size: 1.375rem; }
  .fiche-ajout { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-clair); background: none; border: 0; padding: 0; cursor: pointer; }
  .fiche-ligne { display: flex; gap: var(--espace-m); align-items: flex-start; padding: 0.9375rem 0; border-top: 1px solid var(--filet); }
  .fiche-ligne:last-child { border-bottom: 1px solid var(--filet); }
  .fiche-ligne.fait { opacity: 0.55; }
  .fiche-ligne.vise { outline: 1px solid var(--accent); outline-offset: 0.375rem; }
  .fiche-statut { flex: none; min-width: 5.5rem; text-align: center; font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); background: transparent; border: 1px solid var(--filet); padding: 0.3125rem 0.5625rem; cursor: pointer; }
  .fiche-statut:hover { background: var(--marine); }
  .fiche-statut[data-marqueur='en_cours'] { color: var(--accent-clair); border-color: var(--accent); }
  .fiche-statut[data-terminal] { color: var(--positif); border-color: color-mix(in srgb, var(--positif) 45%, transparent); }
  .fiche-statut.retard { color: var(--alerte); border-color: color-mix(in srgb, var(--alerte) 45%, transparent); }
  .fiche-sujet { flex: 1 1 auto; min-width: 0; font-size: 0.9375rem; }
  .fiche-sous { display: block; margin-top: 0.3125rem; font-size: 0.75rem; color: var(--texte-2); }
  .fiche-sous .alerte { color: var(--alerte); }
  .fiche-vide { padding: var(--espace) 0; color: var(--texte-2); font-size: 0.875rem; border-top: 1px solid var(--filet); border-bottom: 1px solid var(--filet); }
  .fiche-echange { display: flex; gap: 1.25rem; padding: 0.9375rem 0; border-top: 1px solid var(--filet); }
  .fiche-echange:last-of-type { border-bottom: 1px solid var(--filet); }
  .fiche-echange-quand { flex: none; width: 6.875rem; font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.08em; color: var(--texte-2); }
  .fiche-echange-note { flex: 1 1 auto; min-width: 0; font-size: 0.875rem; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
  .fiche-formulaire { margin-bottom: var(--espace); padding: var(--espace-m); border: 1px solid var(--filet); }
  .fiche-formulaire .grille { gap: 0 var(--espace); }
  .fiche-formulaire .actions { margin-top: var(--espace-xs); }
  .fiche-mention { margin: 0 0 var(--espace-xs); font-size: 0.75rem; line-height: 1.7; color: var(--texte-2); }
  .fiche-formulaire textarea { width: 100%; min-height: 5.5rem; resize: vertical; }

  /* Panneau Portail (lecture seule) */
  .portail-carte { border: 1px solid var(--accent); background: color-mix(in srgb, var(--accent) 7%, transparent); padding: 1.625rem 1.5rem; }
  .portail-etiquette { color: var(--accent); margin-bottom: 0.25rem; }
  .portail-viewer { margin: 0 0 1.25rem; font-size: 0.8125rem; color: var(--texte-2); }
  .portail-viewer span { color: var(--texte); }
