---
export const prerender = false;
import Gestion from '../../layouts/Gestion.astro';

// Coquille rendue au serveur : le module (src/scripts/suivi.ts) se charge ensuite de tout l'affichage
// et parle à /api/suivi. L'accès est gardé par le middleware (gestionnaire, éditeur).
const { utilisateur, tenant } = Astro.locals;
if (!utilisateur || !tenant) return Astro.redirect('/connexion');
---
<Gestion titre="Suivi">
  <div class="suivi" id="suivi">
    <div class="suivi-entete">
      <h1>Suivi</h1>
      <p id="suivi-etat" class="suivi-etat" role="status" aria-live="polite" data-etat="chargement">
        <span class="suivi-point" aria-hidden="true"></span><span data-texte>Chargement…</span>
      </p>
    </div>
    <div id="suivi-alertes" class="suivi-alertes" aria-live="polite"></div>
    <div id="suivi-corps">
      <noscript><p class="info alerte">Le module de suivi demande JavaScript.</p></noscript>
    </div>
  </div>
  <script>
    import '../../scripts/suivi';
  </script>
</Gestion>

<style is:global>
  .suivi-entete { display: flex; align-items: baseline; justify-content: space-between; gap: var(--espace); flex-wrap: wrap; }
  .suivi-etat { display: flex; align-items: center; gap: var(--espace-xs); margin: 0; font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); }
  .suivi-point { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--texte-2); }
  .suivi-etat[data-etat='ajour'] .suivi-point { background: var(--positif); }
  .suivi-etat[data-etat='attente'] .suivi-point { background: var(--accent); }
  .suivi-etat[data-etat='refus'] .suivi-point, .suivi-etat[data-etat='horsligne'] .suivi-point { background: var(--alerte); }
  .suivi-etat[data-etat='refus'], .suivi-etat[data-etat='horsligne'] { color: var(--alerte); }
  .suivi-alertes:empty { display: none; }
  .suivi-alertes .info { margin-bottom: var(--espace-s); }

  /* Indicateurs */
  .suivi-kpis { display: flex; flex-wrap: wrap; gap: 0.625rem; margin: var(--espace-l) 0; padding: 0; list-style: none; }
  .suivi-kpis li { flex: 1 1 8.75rem; min-width: 0; display: flex; }
  .suivi-kpi { flex: 1; min-width: 0; text-align: left; font: inherit; color: inherit; background: transparent; border: 1px solid var(--filet); padding: 0.875rem 1rem; cursor: pointer; }
  .suivi-kpi:hover { background: var(--marine); }
  .suivi-kpi[aria-pressed='true'] { background: color-mix(in srgb, var(--accent) 12%, transparent); border-color: var(--accent); }
  .suivi-kpi .chiffre { display: block; font-size: 1.625rem; font-weight: 300; line-height: 1; }
  .suivi-kpi .chiffre small { font-size: 0.875rem; color: var(--texte-2); }
  .suivi-kpi .etiquette { margin-top: 0.45rem; font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.12em; }
  .suivi-kpi[aria-pressed='true'] .etiquette { color: var(--accent-clair); }
  .suivi-kpi.alerte { background: color-mix(in srgb, var(--alerte) 8%, transparent); border-color: color-mix(in srgb, var(--alerte) 45%, transparent); }
  .suivi-kpi.alerte .chiffre, .suivi-kpi.alerte .etiquette { color: var(--alerte); }
  .suivi-kpi.alerte[aria-pressed='true'] { border-color: var(--alerte); background: color-mix(in srgb, var(--alerte) 16%, transparent); }
  .suivi-kpi.manque { cursor: default; border-style: dashed; }
  .suivi-kpi.manque:hover { background: transparent; }
  .suivi-kpi.manque .chiffre { color: var(--texte-2); }
  .suivi-kpi-message { display: block; margin-top: 0.45rem; font-size: 0.75rem; line-height: 1.4; color: var(--texte-2); }
  .suivi-kpi-message a { color: var(--accent-clair); }

  /* Barre d'outils */
  .suivi-outils { display: flex; flex-wrap: wrap; gap: 0.875rem; align-items: center; padding-bottom: var(--espace); border-bottom: 1px solid var(--filet); }
  .suivi-recherche { flex: 1 1 17.5rem; min-width: 0; }
  .suivi-recherche input { width: 100%; padding: 0.7rem 0.9rem; font: inherit; font-size: 0.875rem; color: var(--texte); border: 1px solid var(--filet); }
  .suivi-bascule { display: flex; gap: 2px; border: 1px solid var(--filet); }
  .suivi-bascule button, .suivi-membres button { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); background: transparent; border: 0; padding: 0.7rem 0.875rem; cursor: pointer; }
  .suivi-bascule button[aria-pressed='true'] { background: var(--accent); color: var(--sur-accent); }
  .suivi-membres { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .suivi-membres .etiquette { font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.12em; }
  .suivi-membres button { display: inline-flex; align-items: center; gap: 0.375rem; font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0; text-transform: none; border: 1px solid var(--filet); padding: 0.5rem 0.75rem; }
  .suivi-membres button[aria-pressed='true'] { border-color: var(--accent); color: var(--accent-clair); }
  .suivi-avatar { display: inline-grid; place-items: center; width: 1.125rem; height: 1.125rem; border-radius: 50%; background: var(--texte-2); color: var(--sur-accent); font-family: var(--sans); font-size: 0.5625rem; font-weight: 400; flex: none; }
  .suivi-archives { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--texte-2); }
  .suivi-nouveau { margin-left: auto; }

  /* Liste */
  .suivi-liste { margin-top: var(--espace-xs); }
  .suivi-liste th { padding-top: var(--espace-m); font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.14em; }
  .suivi-liste td { vertical-align: top; padding-top: var(--espace-m); padding-bottom: var(--espace-m); font-size: 0.8125rem; color: var(--texte-2); }
  .suivi-liste tr.archive td { opacity: 0.6; }
  .suivi-nom { background: none; border: 0; padding: 0; font: inherit; font-size: 0.9375rem; color: var(--texte); cursor: pointer; text-align: left; }
  .suivi-nom:hover { color: var(--accent-clair); text-decoration: underline; }
  .suivi-modifier { margin-left: 0.625rem; font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); background: none; border: 0; padding: 0; cursor: pointer; }
  .suivi-modifier:hover { color: var(--accent-clair); }
  .suivi-sous { display: block; margin-top: 0.1875rem; font-size: 0.75rem; color: var(--texte-2); }
  .suivi-sous.mono { font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.08em; }
  .suivi-liste .gros { font-size: 0.9375rem; color: var(--texte); }
  .suivi-liste .gros.saisi { color: var(--texte-2); }
  .suivi-pastille { display: inline-block; font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); border: 1px solid var(--filet); padding: 0.25rem 0.5rem; margin: 0 0.375rem 0.25rem 0; }
  .suivi-pastille.client { color: var(--accent-clair); border-color: var(--accent); }
  .suivi-portail { display: inline-flex; align-items: center; gap: 0.3125rem; font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--positif); }
  .suivi-portail::before { content: ''; width: 0.3125rem; height: 0.3125rem; border-radius: 50%; background: var(--positif); }
  .suivi-liste .alerte, .suivi-liste .perime { color: var(--alerte); }
  .suivi-marque { display: block; margin-top: 0.3125rem; font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-clair); }
  .suivi-marque.refus { color: var(--alerte); }
  .suivi-marque button { font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--accent-clair); background: none; border: 0; padding: 0 0 0 0.5rem; cursor: pointer; text-decoration: underline; }
  .suivi-marque.refus button { color: var(--alerte); }
  .suivi-vide { padding: var(--espace-xl) 0; color: var(--texte-2); }
  .suivi-note { margin: var(--espace) 0 0; max-width: 47.5rem; font-size: 0.75rem; line-height: 1.8; color: var(--texte-2); }

  /* Kanban et parcours : une colonne par statut ou par étape, défilement horizontal si elles ne tiennent pas */
  .suivi-colonnes { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(15rem, 1fr); gap: var(--espace-m); align-items: start; margin-top: var(--espace); padding-bottom: var(--espace-s); overflow-x: auto; }
  .suivi-colonne { min-width: 0; border: 1px solid var(--filet); }
  .suivi-colonne > header { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 0.625rem; padding: 0.875rem 1rem; border-bottom: 1px solid var(--filet); }
  .suivi-colonne > header h2 { margin: 0 auto 0 0; font-family: var(--mono); font-size: 0.625rem; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-clair); }
  .suivi-colonne-n, .suivi-colonne-total { font-family: var(--serif); font-weight: 300; font-size: 1.125rem; line-height: 1; font-variant-numeric: tabular-nums lining-nums; }
  .suivi-colonne-total { flex-basis: 100%; text-align: right; font-size: 0.9375rem; color: var(--texte-2); }
  .suivi-colonne-tag { font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); }
  .suivi-colonne-vide { margin: 0; padding: 1rem; font-size: 0.8125rem; color: var(--texte-2); }
  .suivi-colonne-pied { margin: 0; padding: 0.625rem 1rem; border-top: 1px solid var(--filet); font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--texte-2); }
  .suivi-colonne.terminale .suivi-carte { opacity: 0.6; }
  .suivi-colonne.hors { border-style: dotted; }
  .suivi-colonne.sortie { margin-inline-start: var(--espace); border-style: dashed; }
  .suivi-colonne.sortie .suivi-carte { opacity: 0.75; }
  .suivi-cartes { margin: 0; padding: 0; list-style: none; }
  .suivi-carte { padding: 0.875rem 1rem; border-top: 1px solid var(--filet); }
  .suivi-cartes .suivi-carte:first-child { border-top: 0; }
  .suivi-carte p { margin: 0; }
  .suivi-carte-texte { font-size: 0.9375rem; overflow-wrap: anywhere; }
  .suivi-carte-sous { margin-top: 0.25rem; font-size: 0.75rem; color: var(--texte-2); }
  .suivi-carte-sous .suivi-nom { font-size: 0.75rem; color: var(--texte-2); }
  .suivi-carte .alerte, .suivi-carte .perime { color: var(--alerte); }
  .suivi-carte-avoirs { margin-top: 0.375rem; font-size: 0.8125rem; color: var(--texte-2); }
  .suivi-carte .gros { font-size: 0.9375rem; color: var(--texte); }
  .suivi-carte .gros.saisi { color: var(--texte-2); }
  .suivi-carte .suivi-sous.mono { font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.08em; }
  .suivi-avancer { margin-top: 0.625rem; font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-clair); background: transparent; border: 1px solid var(--accent); padding: 0.4375rem 0.625rem; cursor: pointer; }
  .suivi-avancer:hover { background: var(--marine); }

  /* Fenêtre de saisie */
  .suivi-dialogue { width: min(40rem, calc(100vw - 2rem)); max-height: calc(100vh - 2rem); overflow: auto; padding: var(--espace); color: var(--texte); background: var(--fond); border: 1px solid var(--accent); }
  .suivi-dialogue::backdrop { background: color-mix(in srgb, var(--fond) 80%, transparent); }
  .suivi-dialogue h2 { font-size: 1.25rem; }
  .suivi-dialogue .grille { gap: 0 var(--espace); }
  .suivi-dialogue .groupe label.etiquette { margin-bottom: 0.25rem; }
  .suivi-dialogue fieldset { border: 1px solid var(--filet); margin: 0 0 var(--espace); padding: var(--espace-s) var(--espace-m); }
  .suivi-dialogue legend { padding: 0 0.25rem; }
  .suivi-dialogue .coches { display: flex; flex-wrap: wrap; gap: 0.25rem var(--espace); }
  .suivi-dialogue .coches label { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.875rem; }
  .suivi-dialogue .actions { justify-content: flex-start; }
  .suivi-dialogue .actions .btn:last-child { margin-left: auto; }
  .suivi-dialogue .erreur:empty { display: none; }

  @media (max-width: 48rem) {
    .suivi-nouveau { margin-left: 0; }
    .suivi-colonnes { grid-auto-columns: minmax(15rem, 85%); }
  }
</style>
