---
import Mentions from '../../components/pub/Mentions.astro';
import { envDe } from '../../lib/mail';
import { chargerPage } from '../../lib/site';

const page = await chargerPage(envDe(Astro.locals).DB, Astro.locals.tenant?.id, 'mentions', 'en');
if (!page.c) return Astro.redirect('/mentions-legales', 302);
---
<Mentions langue="en" page={page} />
