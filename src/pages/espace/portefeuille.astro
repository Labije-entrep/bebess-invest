---
import Viewer from '../../layouts/Viewer.astro';
import Selecteur from '../../components/espace/Selecteur.astro';
import { enveloppesDuViewer, lignesDesEnveloppes, portefeuillesDuViewer } from '../../lib/db';
import { euros, pourcent } from '../../lib/format';
import { envDe } from '../../lib/mail';
import { arrete, choixPortefeuille, journaliser, partBp, signe, signeBp, teinte } from '../../lib/espace';

const u = Astro.locals.utilisateur;
const tenant = Astro.locals.tenant;
if (!u || !tenant) return Astro.redirect('/connexion');
const { DB } = envDe(Astro.locals);
await journaliser(DB, u.id, Astro.url.pathname);

const portefeuilles = await portefeuillesDuViewer(DB, tenant.id, u.id);
const choix = choixPortefeuille(portefeuilles, Astro.url.searchParams.get('p'));
const pf = choix.portefeuille?.id ?? null;
const enveloppes = await enveloppesDuViewer(DB, tenant.id, u.id, pf);
const libelleDe = new Map(portefeuilles.map((x) => [x.id, x.libelle]));
const lignes = await lignesDesEnveloppes(DB, enveloppes.map((e) => e.id));
---
<Viewer titre="Portefeuille">
  <h1>Portefeuille</h1>
  <Selecteur portefeuilles={portefeuilles} choisi={pf} afficher={choix.selecteur} />

  {enveloppes.length === 0 && <p class="aide">Aucune enveloppe à afficher.</p>}

  {enveloppes.map((e) => {
    const siennes = lignes.filter((l) => l.enveloppe_id === e.id);
    return (
      <section class="bloc">
        <div class="esp-entete">
          <div>
            <h2>{e.libelle}</h2>
            <span class="etiquette">
              {[choix.consolide ? libelleDe.get(e.portefeuille_id) : null, e.etablissement, e.ouverte_en ? `ouverte en ${e.ouverte_en.slice(0, 4)}` : null, `arrêtée au ${arrete(e.arrete_le)}`].filter(Boolean).join(' · ')}
            </span>
          </div>
          <div class="droite">
            <span class="chiffre num" style="font-size: 1.5rem;">{euros(e.valorisation_cents)}</span><br />
            <span class={`num ${teinte(e.perf_bp)}`}>{e.perf_bp === null ? '—' : signeBp(e.perf_bp)}</span>
          </div>
        </div>
        <div class="defile">
          <table class="table table-large">
            <thead>
              <tr>
                <th>Support</th><th class="num">Valorisation</th><th class="num">Part</th>
                <th class="num">Plus ou moins-value</th><th class="num">Frais annuels</th><th class="num">Arrêté au</th>
              </tr>
            </thead>
            <tbody>
              {siennes.map((l) => (
                <tr>
                  <td>{l.libelle}</td>
                  <td class="num">{euros(l.valorisation_cents)}</td>
                  <td class="num">{pourcent(partBp(l.valorisation_cents, e.valorisation_cents))}</td>
                  <td class={`num ${teinte(l.pv_cents)}`}>{l.pv_cents === null ? '—' : signe(l.pv_cents)}</td>
                  <td class="num">{l.frais_bp === null ? '—' : pourcent(l.frais_bp)}</td>
                  <td class="num">{arrete(l.arrete_le)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    );
  })}

  <p class="mention">
    Le non coté est valorisé chaque trimestre : sa valeur affichée correspond à la dernière
    valorisation disponible et peut différer de sa valeur de cession.
  </p>
</Viewer>
